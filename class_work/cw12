# first task

def recursion(base, expo):
    if expo == 0:
        return 1
    elif expo > 0:
        return base * recursion(base, expo - 1)
    else:
        return 1 / recursion(base, -expo)
    
print(recursion(2, 3))

# second task

def is_leap(year):
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)

def days_in_month(year, month):
    if month in [4, 6, 9, 11]:
        return 30
    elif month == 2:
        return 29 if is_leap(year) else 28
    else:
        return 31
    
def date_to_absolute_date(day, month, year):
    total_days = day
    for year in range(1, year):
        total_days += 366 if is_leap(year) else 365
    for month in range(1, month):
        total_days += days_in_month(year, month)
        return total_days
    

def days_diff(day1, month1, year1, day2, month2, year2):
    abs_date1 = date_to_absolute_date(day1, month1, year1)
    abs_date2 = date_to_absolute_date(day2, month2, year2)
    return abs(abs_date1 - abs_date2)

result = days_diff(1, 1, 2026, 8, 3, 2026)
print(f'Difference in days: {result}')

# third task

import random

num = [random.randint(1, 100) for _ in range(10)]

def find_min(id):
    if id > len(num) - 10:
        return id, float('inf')
    
    current_sum = sum(num[id : id + 10])

    next_id, next_min_sum = find_min(id + 1)

    if current_sum < next_min_sum:
        return id, current_sum
    else:
        return next_id, next_min_sum
    
best_index, min_sum = find_min(0)
print(f'Beginning on index: {best_index}')
print(f'Sum: {min_sum}')

