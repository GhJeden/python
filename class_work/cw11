def count_unpair(num1, num2):
    num1 = input("Write first num: ")
    num2 = input("Write second num: ")
    start = min(num1, num2)
    end = max(num1, num2)

    for i in range(start, end + 1):
        if i % 2 != 0:
            print(i, end=" ")
        print()

count_unpair(num1=10, num2=20)


def draw_line(length, direction, symbol):
    """
    length: int
    direction: str
    symbol: str
    """
    if direction.lower() == 'h':
        print(symbol * length)
    elif direction.lower() == 'v':
        for _ in range(length):
            print(symbol)
    else:
        print('Error, direction must be "h"(horizontal) or "v"(vertical)')


print('Horizontal line: ')
draw_line(10, 'h', '*')

print('Vertical line: ')
draw_line(5, 'v', '|')



