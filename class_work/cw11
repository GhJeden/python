def kruty_nomery(n):
    if n <= 1:
        return False

    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False

    return True


numb = int(input("Enter the number: "))

print(kruty_nomery(numb))

def is_lucky(n):
    if not (100000 <= n <= 999999):
        return False
    
    s1 = (n // 100000) + ((n // 10000) % 10) + ((n // 1000) % 10)
    
    s2 = ((n // 100) % 10) + ((n // 10) % 10) + (n % 10)
    
    return s1 == s2