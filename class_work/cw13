# Third task

try:
    marks = input("Enter your grades (separated by space): ")

    grades = [int(x)
    for x in marks.split()]

    avg = sum(grades) / len(grades)

except ValueError:
    print("You entered an invalid grade! Please enter only numbers.")
except ZeroDivisionError:
    print("You didn't enter any grades!")

finally:
    print(f"Your average grade: {avg} \n Your grades: {grades} ")

# Fourth task

num_for_pay = float(input('Enter the amount to pay(the sum needs to be divisible by 10): '))
try:
    if num_for_pay < 0:
        raise Exception('Incorrect amount!')
    if num_for_pay % 10 != 0:
        raise Exception('Amount must be divisible by 10!')
    print(f'You need to pay: {num_for_pay}')
except Exception as e:
    print(f'Error: {e}')
finally:
    print('Thank you for using our payment system!')

