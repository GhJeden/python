class vampire:
    def __init__(self, name, health, damage) -> None:
        self.name = name
        self.health = health
        self.damage = damage

    def attack(self, target):
        print(f"Vampire {self.name} attacks {target.name} for {self.damage} damage!")
        target.health -= self.damage

    def lifesteal(self, target):
        print(f"Vampire {self.name} steals life from {target.name} for {self.damage} health!")
        target.health -= self.damage
        self.health += self.damage

    def __str__(self) -> str:
        print(f'Name: {self.name}\nHealth: {self.health}\nDamage: {self.damage}')