class fighter:
    def __init__(self, name, health, damage) -> None:
        self.name = name
        self.health = health
        self.damage = damage

    def attack(self, target):
        print(f"Fighter {self.name} attacks {target.name} for {self.damage} damage!")
        target.health -= self.damage

    def __str__(self) -> str:
        print(f'Name: {self.name}\nHealth: {self.health}\nDamage: {self.damage}')

class healer:
    def __init__(self, name, health, heal_amount) -> None:
        self.name = name
        self.health = health
        self.heal = heal_amount

    def heal(self, target):
        print(f"Healer {self.name} heals {target.name} for {self.heal} health!")
        target.health += self.heal

    def __str__(self) -> str:
        print(f'Name: {self.name}\nHealth: {self.health}\nHealing Power: {self.heal}')
    
