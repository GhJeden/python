# Entering the list of numbers
input_str = input("Enter list of numbers(like 1,2,3,4,5): ")
numbers = [int(x.strip()) for x in input_str.split(',')]

# Entering amount of positions
N = int(input("Enter number of position N for shifting it on the right: "))

# Cycle for shifting on the right: last N numbers + first till the end
shifted = numbers[-N % len(numbers):] + numbers[:-N % len(numbers)]

# Виведення результату
print("Shifted list:", shifted)



