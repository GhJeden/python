"""
"""
reserved_words = ["if", "else", "for", "while", "def", "class", "return"]

text = input("Enter the text: ")

words = text.split()

for i in range(len(words)):
    clean_word = words[i].strip(".,!?()")
    if clean_word in reserved_words:
        words[i] = words[i].replace(clean_word, clean_word.upper())

new_text = " ".join(words)

print("Remaked text:")
print(new_text)
