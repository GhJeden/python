def result(a, b):
    if b == 0:
        return a
    return result(b, a % b)


a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

print("Answer is", result(a, b))

def sum(n):
    if n == 0:
        return 0
    return n % 10 + sum(n // 10)


n = int(input("Enter a number: "))
print("Answer is", sum(n))

def is_symmetric(list):
    if len(list) <= 1:
        return True
    if list[0] != list[-1]:
        return False
    return is_symmetric(list[1:-1])


list_user = list(map(int, input("Enter numbers (separated by space) -> ").split()))
list = list_user
if is_symmetric(list):
    print("Symmetric")
else:
    print("Not symmetric")
