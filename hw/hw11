def square(size, symbol, fill):
    for i in range(size):
        for j in range(size):
            if fill:
                print(symbol, end=" ")
            else:
                if i == 0 or i == size-1 or j == 0 or j == size-1:
                    print(symbol, end=" ")
                else:
                    print(" ", end=" ")
        print()


size = int(input("Enter length: "))
symbol = input("Enter symbol: ")
fill = input("Write True/False to make filled square or not filled: ")

if fill == "True":
    fill = True
else:
    fill = False


square(size, symbol, fill)


def count(number):
    if number == 0:
        return 1

    count = 0
    number = abs(number)

    while number > 0:
        number //= 10
        count += 1

    return count


result = count(1488)
print(result)

def is_pal(num):
    num_str = str(num)

    if num_str == num_str[::-1]:
        return True
    else:
        return False


user_word = input("Enter word: ")

result = is_pal(user_word)

print(result)