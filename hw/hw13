# Third task
try:
    number = input('Enter information about sale(separated by space): ')
    sale_info = number.split()
    if len(sale_info) != 3:
        raise ValueError('Invalid input format')
    product = sale_info[0]
    quantity = int(sale_info[1])
    price = float(sale_info[2])
    total = quantity * price
    print(f'Sale information: {product}, Quantity: {quantity}, Price: {price}, Total: {total}')
except ValueError as e:
    print(f'Error: {e}')
except Exception as e:
    print(f'Unexpected error: {e}')
finally:
    print('End of program')

